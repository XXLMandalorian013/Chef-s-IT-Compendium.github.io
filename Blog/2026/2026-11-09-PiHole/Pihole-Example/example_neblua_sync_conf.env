# Nebula sync settings .env conf file.
# Specifies the primary Pi-hole configuration.
PRIMARY="http://YourPrimaryPiIPHere|YourPiHolePWHere"
# Specifies the list of replica Pi-hole configurations ie, REPLICAS="https://XXX.XXX.XXX.XXX|PWHere","https://XXX.XXX.XXX.XXX|PWHere"
REPLICAS="http://YourSecondaryPiIPHere|YourPiHolePWHere"
# Specifies whether to perform a full synchronization each sync. If false, can specify specifically what you want to sync vs all.
FULL_SYNC=false
# If FULL_SYNC=false, specify what you want to sync. See the projects GitHub for a full cmd list. https://github.com/lovelaze/nebula-sync
# I am disabling this as I will specify each Pis IP + the unbound port so I don't want the primary to send its settings, overwriting the secondary.
SYNC_CONFIG_DNS=false
SYNC_CONFIG_DHCP=false
SYNC_CONFIG_NTP=false
SYNC_CONFIG_RESOLVER=false
SYNC_CONFIG_DATABASE=true
SYNC_CONFIG_MISC=true
SYNC_CONFIG_DEBUG=false
SYNC_GRAVITY_DHCP_LEASES=false
SYNC_GRAVITY_GROUP=true
SYNC_GRAVITY_AD_LIST=true
SYNC_GRAVITY_AD_LIST_BY_GROUP=true
SYNC_GRAVITY_DOMAIN_LIST=true
SYNC_GRAVITY_DOMAIN_LIST_BY_GROUP=true
SYNC_GRAVITY_CLIENT=true
SYNC_GRAVITY_CLIENT_BY_GROUP=true
# GRAVITY=allow/block list settings. Specifies whether to run gravity after syncing. Will run eventually on its own if not specified to do so here.
RUN_GRAVITY=true
# Specifies the cron schedule for synchronization between the primary and the replicas. 15/ will sync every 15 min.
CRON="*/15 * * * *"
# Skips TLS certificate verification. If your pis are http vs https set true.
CLIENT_SKIP_TLS_VERIFICATION=true
# Specifies the timezone for logs and cron.
TZ=America/New_York


